{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" }
  ],
  "id": null,
  "uid": "keel-overview",
  "title": "KEEL – Connection Pooler Overview",
  "description": "Real-time monitoring dashboard for KEEL PostgreSQL connection pooler – sessions, pools, query routing, latency histograms, errors, TLS, I/O, tracing, and system resources.",
  "tags": ["keel", "postgresql", "pooler", "observability"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "uid": "${datasource}" },
        "query": "label_values(keel_uptime_seconds, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "worker",
        "type": "query",
        "datasource": { "uid": "${datasource}" },
        "query": "label_values(keel_sessions_active{instance=~\"$instance\"}, worker)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "TLS cert reloads",
        "datasource": { "uid": "${datasource}" },
        "expr": "increase(keel_tls_cert_reloads{instance=~\"$instance\"}[1m]) > 0",
        "enable": true,
        "iconColor": "blue",
        "titleFormat": "TLS cert reloaded"
      }
    ]
  },
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Uptime",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [{ "expr": "keel_uptime_seconds{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Workers",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
      },
      "targets": [{ "expr": "keel_workers{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 1000 }
          ]}
        }
      },
      "targets": [{ "expr": "sum(keel_sessions_active{instance=~\"$instance\", worker=~\"$worker\"})", "legendFormat": "total" }]
    },
    {
      "title": "Queries / sec",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{ "expr": "sum(rate(keel_queries_total_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "qps" }]
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [{ "expr": "sum(rate(keel_errors_total_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "errors/s" }]
    },
    {
      "title": "Pool Utilization",
      "type": "gauge",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ]}
        }
      },
      "targets": [{ "expr": "keel_pool_utilization_ratio{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "title": "p99 Query Latency",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10000000 },
            { "color": "red", "value": 100000000 }
          ]}
        }
      },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }]
    },
    {
      "title": "RSS",
      "type": "stat",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 536870912 },
            { "color": "red", "value": 1073741824 }
          ]}
        }
      },
      "targets": [{ "expr": "keel_rss_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    },

    {
      "title": "Sessions",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Active Sessions per Worker",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "keel_sessions_active{instance=~\"$instance\", worker=~\"$worker\"}", "legendFormat": "worker-{{worker}}" }
      ]
    },
    {
      "title": "Session Create / Close Rate",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(keel_sessions_created_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "created/s" },
        { "expr": "sum(rate(keel_sessions_closed_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "closed/s" }
      ]
    },

    {
      "title": "Connection Pool",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "title": "Pool Connections Breakdown",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } },
      "targets": [
        { "expr": "keel_pool_connections_active{instance=~\"$instance\"}", "legendFormat": "active" },
        { "expr": "keel_pool_connections_idle{instance=~\"$instance\"}", "legendFormat": "idle" },
        { "expr": "keel_pool_connections_cleaning{instance=~\"$instance\"}", "legendFormat": "cleaning" },
        { "expr": "keel_pool_connections_pinned{instance=~\"$instance\"}", "legendFormat": "pinned" }
      ]
    },
    {
      "title": "Pool Hit / Miss Rate",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(keel_pool_hits_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "hits/s" },
        { "expr": "sum(rate(keel_pool_misses_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "misses/s" },
        { "expr": "keel_pool_waiting_sessions{instance=~\"$instance\"}", "legendFormat": "waiting" }
      ]
    },
    {
      "title": "Pool Borrow / Return / Create / Destroy",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_pool_borrows_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "borrow/s" },
        { "expr": "sum(rate(keel_pool_returns_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "return/s" },
        { "expr": "sum(rate(keel_pool_creates_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "create/s" },
        { "expr": "sum(rate(keel_pool_destroys_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "destroy/s" }
      ]
    },

    {
      "title": "Query Routing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "title": "Query Rate by Type",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(keel_queries_read_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "read" },
        { "expr": "sum(rate(keel_queries_write_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "write" },
        { "expr": "sum(rate(keel_queries_tx_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "transaction" }
      ]
    },
    {
      "title": "Read / Write Ratio",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 30 } } },
      "targets": [
        {
          "expr": "sum(rate(keel_queries_read_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(keel_queries_total_total{instance=~\"$instance\"}[$__rate_interval])), 1)",
          "legendFormat": "read %"
        },
        {
          "expr": "sum(rate(keel_queries_write_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(keel_queries_total_total{instance=~\"$instance\"}[$__rate_interval])), 1)",
          "legendFormat": "write %"
        }
      ]
    },

    {
      "title": "Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },
    {
      "title": "Query Latency Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Backend Latency Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(keel_backend_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(keel_backend_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(keel_backend_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Connect Latency Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(keel_connect_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(keel_connect_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(keel_connect_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Pool Wait Latency Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(keel_wait_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(keel_wait_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(keel_wait_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Query Latency Heatmap",
      "type": "heatmap",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 57 },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "ns" },
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "tooltip": { "show": true }
      },
      "targets": [
        { "expr": "sum(increase(keel_query_latency_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le)", "legendFormat": "{{le}}", "format": "heatmap" }
      ]
    },

    {
      "title": "Errors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
      "collapsed": false
    },
    {
      "title": "Error Rate by Type",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 66 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(keel_errors_auth_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "auth" },
        { "expr": "sum(rate(keel_errors_proto_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "protocol" },
        { "expr": "sum(rate(keel_errors_backend_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "backend" },
        { "expr": "sum(rate(keel_errors_timeout_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "timeout" }
      ]
    },
    {
      "title": "Proxy Safety Counters",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 66 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_proxy_state_desync_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "state desync" },
        { "expr": "sum(rate(keel_proxy_orphaned_transactions_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "orphaned txn" },
        { "expr": "sum(rate(keel_proxy_backend_reuse_failure_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "reuse failure" },
        { "expr": "sum(rate(keel_proxy_io_uring_sq_overflow_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "SQ overflow" }
      ]
    },

    {
      "title": "Throughput & I/O",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 74 },
      "collapsed": false
    },
    {
      "title": "Network Throughput",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 75 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 20 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(keel_bytes_recv_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "client → keel" },
        { "expr": "sum(rate(keel_bytes_sent_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "keel → client" },
        { "expr": "sum(rate(keel_bytes_backend_recv_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "backend → keel" },
        { "expr": "sum(rate(keel_bytes_backend_sent_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "keel → backend" }
      ]
    },
    {
      "title": "io_uring Operations",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 75 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_ops_submitted_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "SQE submitted/s" },
        { "expr": "sum(rate(keel_ops_completed_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "CQE completed/s" },
        { "expr": "sum(rate(keel_loop_iterations_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "loop iter/s" }
      ]
    },

    {
      "title": "TLS",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 83 },
      "collapsed": false
    },
    {
      "title": "TLS Connections",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 84 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_tls_connections_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "total" },
        { "expr": "sum(rate(keel_tls_connections_succeeded{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "succeeded" },
        { "expr": "sum(rate(keel_tls_connections_failed{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "failed" }
      ]
    },
    {
      "title": "kTLS",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 84 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "keel_tls_ktls_active{instance=~\"$instance\"}", "legendFormat": "active kTLS" },
        { "expr": "sum(rate(keel_ktls_installations_succeeded{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "installed/s" },
        { "expr": "sum(rate(keel_ktls_installations_failed{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "failed/s" }
      ]
    },

    {
      "title": "Tracing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 92 },
      "collapsed": false
    },
    {
      "title": "Trace Span Throughput",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 93 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } } },
      "targets": [
        { "expr": "sum(rate(keel_trace_spans_created{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "created/s" },
        { "expr": "sum(rate(keel_trace_spans_exported{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "exported/s" },
        { "expr": "sum(rate(keel_trace_spans_dropped{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "dropped/s" }
      ]
    },
    {
      "title": "Trace Export Health",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 93 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_trace_export_batches{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "batches/s" },
        { "expr": "sum(rate(keel_trace_export_errors{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "errors/s" }
      ]
    },

    {
      "title": "Worker Rebalancing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 101 },
      "collapsed": false
    },
    {
      "title": "Session Migrations",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 102 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_migrations_sent_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "sent/s" },
        { "expr": "sum(rate(keel_migrations_received_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "received/s" },
        { "expr": "sum(rate(keel_rebalance_migrations_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "auto-rebalance/s" }
      ]
    },
    {
      "title": "Rebalance Activity",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 102 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(keel_rebalance_checks_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "checks/s" },
        { "expr": "sum(rate(keel_rebalance_skipped_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "skipped/s" }
      ]
    },

    {
      "title": "System Resources",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 110 },
      "collapsed": false
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 111 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20 } } },
      "targets": [
        { "expr": "keel_cpu_user_pct{instance=~\"$instance\"}", "legendFormat": "user" },
        { "expr": "keel_cpu_sys_pct{instance=~\"$instance\"}", "legendFormat": "system" }
      ]
    },
    {
      "title": "Memory (RSS)",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 111 },
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": { "fillOpacity": 20 } } },
      "targets": [
        { "expr": "keel_rss_bytes{instance=~\"$instance\"}", "legendFormat": "RSS" }
      ]
    },
    {
      "title": "File Descriptors",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 111 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "keel_fd_open{instance=~\"$instance\"}", "legendFormat": "open" },
        { "expr": "keel_fd_limit{instance=~\"$instance\"}", "legendFormat": "limit" }
      ]
    },
    {
      "title": "Buffer Pool Utilization",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 119 },
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "keel_proxy_buffer_pool_utilization_bytes{instance=~\"$instance\", worker=~\"$worker\"}", "legendFormat": "worker-{{worker}}" }
      ]
    },
    {
      "title": "Session Duration Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 119 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    }
  ]
}
