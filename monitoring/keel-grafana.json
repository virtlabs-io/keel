{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping KEEL /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "title": "KEEL — Database Connection Pooler",
  "description": "Operational dashboard for KEEL proxy. Import with the Prometheus datasource pointed at keel's /metrics endpoint.",
  "tags": ["keel", "database", "connection-pool", "postgresql", "mysql"],
  "schemaVersion": 38,
  "version": 1,
  "uid": "keel-main-v1",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(keel_uptime_seconds, instance)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "keel_uptime_seconds{instance=~\"$instance\"}",
          "legendFormat": "uptime"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "s",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Workers",
      "gridPos": { "x": 4, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_workers{instance=~\"$instance\"}", "legendFormat": "workers" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "x": 7, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_pool_connections_active{instance=~\"$instance\"}", "legendFormat": "active" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 80 },
            { "color": "red", "value": 95 }
          ]
        },
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Waiting Sessions",
      "gridPos": { "x": 11, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_pool_waiting_sessions{instance=~\"$instance\"}", "legendFormat": "waiting" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ]
        },
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Pool Utilization",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_pool_utilization_ratio{instance=~\"$instance\"} * 100", "legendFormat": "utilization %" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queries per Second",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(keel_router_total_routes{instance=~\"$instance\"}[1m])",
          "legendFormat": "total"
        },
        {
          "expr": "rate(keel_router_read_routes{instance=~\"$instance\"}[1m])",
          "legendFormat": "reads"
        },
        {
          "expr": "rate(keel_router_write_routes{instance=~\"$instance\"}[1m])",
          "legendFormat": "writes"
        },
        {
          "expr": "rate(keel_router_failover_routes{instance=~\"$instance\"}[1m])",
          "legendFormat": "failovers"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Query Latency (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(keel_query_latency_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Connection Pool — Active / Idle / Pinned / Waiting",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "keel_pool_connections_active{instance=~\"$instance\"}",
          "legendFormat": "active"
        },
        {
          "expr": "keel_pool_connections_idle{instance=~\"$instance\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "keel_pool_connections_pinned{instance=~\"$instance\"}",
          "legendFormat": "pinned"
        },
        {
          "expr": "keel_pool_connections_cleaning{instance=~\"$instance\"}",
          "legendFormat": "cleaning"
        },
        {
          "expr": "keel_pool_waiting_sessions{instance=~\"$instance\"}",
          "legendFormat": "client wait queue"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Backend Connect Latency (ms)",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(keel_connect_latency_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(keel_connect_latency_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Read Offload Ratio (reads → replicas)",
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(keel_router_read_routes{instance=~\"$instance\"}[5m]) / clamp_min(rate(keel_router_total_routes{instance=~\"$instance\"}[5m]), 0.001)",
          "legendFormat": "read offload ratio"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "File Descriptor Usage",
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_fd_open{instance=~\"$instance\"}", "legendFormat": "open FDs" },
        { "expr": "keel_fd_limit{instance=~\"$instance\"}", "legendFormat": "FD limit" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": { "x": 16, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_rss_bytes{instance=~\"$instance\"}", "legendFormat": "RSS" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "TLS — Connections & Security Events",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(keel_tls_connections_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "TLS connections/s"
        },
        {
          "expr": "increase(keel_tls_downgrade_rejected{instance=~\"$instance\"}[5m])",
          "legendFormat": "downgrade rejections (5m)"
        },
        {
          "expr": "increase(keel_tls_cert_reloads{instance=~\"$instance\"}[5m])",
          "legendFormat": "cert reloads (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Session Duration (ms)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(keel_session_duration_ns_bucket{instance=~\"$instance\"}[5m])) / 1e6",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cluster — Peers & Elections",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "keel_cluster_peers_up{instance=~\"$instance\"}", "legendFormat": "peers up" },
        { "expr": "keel_cluster_peers_down{instance=~\"$instance\"}", "legendFormat": "peers down" },
        {
          "expr": "rate(keel_cluster_elections_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "elections/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Tracing — Spans Created / Exported / Dropped",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(keel_trace_spans_created{instance=~\"$instance\"}[1m])",
          "legendFormat": "created/s"
        },
        {
          "expr": "rate(keel_trace_spans_exported{instance=~\"$instance\"}[1m])",
          "legendFormat": "exported/s"
        },
        {
          "expr": "rate(keel_trace_spans_dropped{instance=~\"$instance\"}[1m])",
          "legendFormat": "dropped/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
