# =============================================================================
# Percona XtraDB Cluster — Node 1 (Bootstrap)
# =============================================================================
[mysqld]
server-id                     = 1
bind-address                  = 0.0.0.0

# InnoDB (required for Galera)
default-storage-engine        = InnoDB
innodb-autoinc-lock-mode      = 2
innodb-buffer-pool-size       = 256M

# Connections
max-connections               = 200


# Disable SSL for Galera cluster traffic (test only)
loose-pxc_encrypt_cluster_traffic = OFF
