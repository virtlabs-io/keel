{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",        "version": "" },
    { "type": "panel",      "id": "gauge",      "name": "Gauge",       "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",       "version": "" }
  ],
  "id": null,
  "uid": "keel-overview",
  "title": "KEEL Connection Pooler",
  "description": "Comprehensive dashboard for KEEL database connection pooler — sessions, pool, queries, routing, cluster, TLS, tracing, and system metrics",
  "tags": ["keel", "database", "proxy", "connection-pooler", "sharding", "cluster", "tls", "tracing"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(keel_sessions_active, worker)",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Sessions",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red",    "value": 500 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_sessions_active_total", "legendFormat": "active" }]
    },
    {
      "title": "Sessions Created",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_sessions_created_total", "legendFormat": "created" }]
    },
    {
      "title": "Connection Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(keel_sessions_created_total[5m])", "legendFormat": "creates/s" },
        { "expr": "rate(keel_sessions_closed_total[5m])",  "legendFormat": "closes/s"  }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "rate(keel_errors_total_total[5m])",   "legendFormat": "total/s"   },
        { "expr": "rate(keel_errors_auth_total[5m])",    "legendFormat": "auth/s"    },
        { "expr": "rate(keel_errors_backend_total[5m])", "legendFormat": "backend/s" },
        { "expr": "rate(keel_errors_proto_total[5m])",   "legendFormat": "proto/s"   },
        { "expr": "rate(keel_errors_timeout_total[5m])", "legendFormat": "timeout/s" }
      ]
    },
    {
      "title": "Auth Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_errors_auth_total", "legendFormat": "auth errors" }]
    },
    {
      "title": "Proto / Timeout Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "keel_errors_proto_total",   "legendFormat": "proto"   },
        { "expr": "keel_errors_timeout_total", "legendFormat": "timeout" }
      ]
    },
    {
      "title": "Pool",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Pool Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "keel_pool_connections_active",   "legendFormat": "active"   },
        { "expr": "keel_pool_connections_idle",     "legendFormat": "idle"     },
        { "expr": "keel_pool_connections_pinned",   "legendFormat": "pinned"   },
        { "expr": "keel_pool_connections_cleaning", "legendFormat": "cleaning" },
        { "expr": "keel_pool_waiting_sessions",     "legendFormat": "waiting"  }
      ]
    },
    {
      "title": "Pool Utilization",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.7  },
            { "color": "red",    "value": 0.9  }
          ]}
        }
      },
      "targets": [{ "expr": "keel_pool_utilization_ratio", "legendFormat": "utilization" }]
    },
    {
      "title": "Pool Creates / Destroys",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "expr": "rate(keel_pool_creates_total[5m])",  "legendFormat": "creates/s"  },
        { "expr": "rate(keel_pool_destroys_total[5m])", "legendFormat": "destroys/s" }
      ]
    },
    {
      "title": "Pool Hit Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_pool_hits_total / (keel_pool_hits_total + keel_pool_misses_total + 1)", "legendFormat": "hit rate" }]
    },
    {
      "title": "Multiplex Ratio",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "decimals": 2, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "proxy_multiplex_ratio", "legendFormat": "ratio" }]
    },
    {
      "title": "Sticky / Pinned Sessions",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "proxy_sticky_sessions", "legendFormat": "sticky" }]
    },
    {
      "title": "Buffer Pool Utilization",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1 } } },
      "targets": [{ "expr": "proxy_buffer_pool_utilization_bytes", "legendFormat": "recv buffer bytes" }]
    },
    {
      "title": "Query Performance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Query Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(keel_queries_total_total[5m])", "legendFormat": "total/s" },
        { "expr": "rate(keel_queries_read_total[5m])",  "legendFormat": "read/s"  },
        { "expr": "rate(keel_queries_write_total[5m])", "legendFormat": "write/s" },
        { "expr": "rate(keel_queries_tx_total[5m])",    "legendFormat": "tx/s"    }
      ]
    },
    {
      "title": "Query Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_query_latency_ns{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "expr": "keel_query_latency_ns{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "keel_query_latency_ns{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Backend Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_backend_latency_ns{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "expr": "keel_backend_latency_ns{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "keel_backend_latency_ns{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Pool Wait Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_wait_latency_ns{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "expr": "keel_wait_latency_ns{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "keel_wait_latency_ns{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Connect Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_connect_latency_ns{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "expr": "keel_connect_latency_ns{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "keel_connect_latency_ns{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Session Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "ns", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_session_duration_ns{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "expr": "keel_session_duration_ns{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "keel_session_duration_ns{quantile=\"0.99\"}", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Bytes Throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(keel_bytes_recv_total[5m])",         "legendFormat": "frontend rx" },
        { "expr": "rate(keel_bytes_sent_total[5m])",         "legendFormat": "frontend tx" },
        { "expr": "rate(keel_bytes_backend_recv_total[5m])", "legendFormat": "backend rx"  },
        { "expr": "rate(keel_bytes_backend_sent_total[5m])", "legendFormat": "backend tx"  }
      ]
    },
    {
      "title": "Protocol Events",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "expr": "rate(keel_proxy_state_desync_total_total[5m])",          "legendFormat": "state desync/s"   },
        { "expr": "rate(keel_proxy_orphaned_transactions_total_total[5m])", "legendFormat": "orphaned txns/s"  },
        { "expr": "rate(keel_proxy_backend_reuse_failure_total_total[5m])", "legendFormat": "reuse failures/s" },
        { "expr": "rate(keel_proxy_io_uring_sq_overflow_total_total[5m])",  "legendFormat": "sq overflow/s"    }
      ]
    },
    {
      "title": "Routing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Route Distribution",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(keel_router_total_routes[5m])",    "legendFormat": "total/s"    },
        { "expr": "rate(keel_router_read_routes[5m])",     "legendFormat": "reads/s"    },
        { "expr": "rate(keel_router_write_routes[5m])",    "legendFormat": "writes/s"   },
        { "expr": "rate(keel_router_failover_routes[5m])", "legendFormat": "failover/s" },
        { "expr": "rate(keel_router_pinned_routes[5m])",   "legendFormat": "pinned/s"   }
      ]
    },
    {
      "title": "Shard Routes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "rate(keel_router_shard_routes[5m])",   "legendFormat": "shard={{shard}}" },
        { "expr": "rate(keel_router_scatter_hits[5m])",   "legendFormat": "scatter hits/s"  },
        { "expr": "rate(keel_router_scatter_failed[5m])", "legendFormat": "scatter fail/s"  }
      ]
    },
    {
      "title": "Rebalance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "expr": "rate(keel_rebalance_checks_total[5m])",     "legendFormat": "checks/s"     },
        { "expr": "rate(keel_rebalance_migrations_total[5m])", "legendFormat": "migrations/s" },
        { "expr": "rate(keel_rebalance_skipped_total[5m])",    "legendFormat": "skipped/s"    },
        { "expr": "rate(keel_migrations_sent_total[5m])",      "legendFormat": "sent/s"       },
        { "expr": "rate(keel_migrations_received_total[5m])",  "legendFormat": "recv/s"       }
      ]
    },
    {
      "title": "Notify Relay / OSC Sessions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "expr": "rate(keel_notify_relayed_total[5m])",        "legendFormat": "notifies relayed/s" },
        { "expr": "rate(keel_osc_sessions_detected_total[5m])", "legendFormat": "OSC sessions/s"     }
      ]
    },
    {
      "title": "TLS & kTLS",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "TLS Handshakes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "rate(keel_tls_connections_total[5m])",     "legendFormat": "initiated/s"          },
        { "expr": "rate(keel_tls_connections_succeeded[5m])", "legendFormat": "succeeded/s"          },
        { "expr": "rate(keel_tls_connections_failed[5m])",    "legendFormat": "failed/s"             },
        { "expr": "rate(keel_tls_downgrade_rejected[5m])",    "legendFormat": "downgrade rejected/s" }
      ]
    },
    {
      "title": "kTLS Kernel Installs",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "rate(keel_ktls_installations_attempted[5m])", "legendFormat": "attempted/s"    },
        { "expr": "rate(keel_ktls_installations_succeeded[5m])", "legendFormat": "succeeded/s"    },
        { "expr": "rate(keel_ktls_installations_failed[5m])",    "legendFormat": "failed/s"       },
        { "expr": "rate(keel_ktls_cipher_incompatible[5m])",     "legendFormat": "incompatible/s" },
        { "expr": "rate(keel_ktls_kernel_errors[5m])",           "legendFormat": "kernel errors/s" }
      ]
    },
    {
      "title": "kTLS Active",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 73 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_tls_ktls_active", "legendFormat": "active" }]
    },
    {
      "title": "TLS Cert Reloads / Failures",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 73 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "keel_tls_cert_reloads",         "legendFormat": "reloads"  },
        { "expr": "keel_tls_cert_reload_failures",  "legendFormat": "failures" }
      ]
    },
    {
      "title": "kTLS Fallback",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 73 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_tls_ktls_fallback", "legendFormat": "fallbacks" }]
    },
    {
      "title": "Distributed Tracing (OTLP)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 77 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Span Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "rate(keel_trace_spans_created[5m])",  "legendFormat": "created/s"  },
        { "expr": "rate(keel_trace_spans_exported[5m])", "legendFormat": "exported/s" },
        { "expr": "rate(keel_trace_spans_dropped[5m])",  "legendFormat": "dropped/s"  }
      ]
    },
    {
      "title": "Export Health",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "rate(keel_trace_export_batches[5m])", "legendFormat": "batches/s" },
        { "expr": "rate(keel_trace_export_errors[5m])",  "legendFormat": "errors/s"  }
      ]
    },
    {
      "title": "Spans Dropped",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 86 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 100 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_trace_spans_dropped", "legendFormat": "dropped" }]
    },
    {
      "title": "Export Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 86 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "keel_trace_export_errors", "legendFormat": "errors" }]
    },
    {
      "title": "System Resources",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 90 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 91 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "keel_cpu_user_pct", "legendFormat": "user %" },
        { "expr": "keel_cpu_sys_pct",  "legendFormat": "sys %"  }
      ]
    },
    {
      "title": "Memory (RSS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 91 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "keel_rss_bytes", "legendFormat": "RSS" }]
    },
    {
      "title": "File Descriptors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 91 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "keel_fd_open",  "legendFormat": "open"  },
        { "expr": "keel_fd_limit", "legendFormat": "limit" }
      ]
    },
    {
      "title": "io_uring Throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 99 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [
        { "expr": "rate(keel_loop_iterations_total[5m])", "legendFormat": "loop iter/s"  },
        { "expr": "rate(keel_ops_submitted_total[5m])",   "legendFormat": "sqe submit/s" },
        { "expr": "rate(keel_ops_completed_total[5m])",   "legendFormat": "cqe reaped/s" }
      ]
    },
    {
      "title": "Workers / Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 99 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "keel_workers",        "legendFormat": "workers"  },
        { "expr": "keel_uptime_seconds", "legendFormat": "uptime s" }
      ]
    },
    {
      "title": "Worker Stalled / Stale",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 99 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "proxy_heartbeat_stalled_workers", "legendFormat": "stalled" },
        { "expr": "proxy_stale_connection_workers",  "legendFormat": "stale"   }
      ]
    },
    {
      "title": "Connection Age",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 103 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1 } } },
      "targets": [{ "expr": "proxy_connection_age_seconds", "legendFormat": "oldest conn age" }]
    },
    {
      "title": "io_uring SQ Overflow",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 107 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1 } } },
      "targets": [{ "expr": "rate(proxy_io_uring_sq_overflow_total[5m])", "legendFormat": "sq overflow/s" }]
    }
  ]
}
