/**
 * @file config.h
 * @brief KEEL build configuration (auto-generated by CMake)
 *
 * This file is automatically generated from cmake/keel_config.h.in by the
 * configure_file() command in the root CMakeLists.txt.  CMake substitutes
 * at-sign-delimited variables and evaluates cmakedefine directives based
 * on the current build configuration.
 *
 * DO NOT EDIT MANUALLY -- changes will be overwritten on the next cmake run.
 *
 * Contents:
 *   - Version triplet (MAJOR.MINOR.PATCH) and full version string
 *   - Platform detection flags (KEEL_PLATFORM_LINUX, _MACOS, _WINDOWS)
 *   - I/O backend feature flags (KEEL_USE_IOURING, KEEL_USE_LIBUV)
 *   - Stats / instrumentation tier flags (L3, L4, L5)
 *   - Build type string and compiler identification
 *
 * Every public header includes this file transitively so that compile-time
 * feature checks (e.g. KEEL_USE_IOURING) are available everywhere without
 * requiring cmake-specific include paths in downstream code.
 */

#ifndef KEEL_CONFIG_H
#define KEEL_CONFIG_H

/* Version information */
#define KEEL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define KEEL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define KEEL_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define KEEL_VERSION "@PROJECT_VERSION@"

/* Platform detection */
#cmakedefine KEEL_PLATFORM_LINUX
#cmakedefine KEEL_PLATFORM_MACOS
#cmakedefine KEEL_PLATFORM_WINDOWS
#define KEEL_PLATFORM "@KEEL_PLATFORM@"

/* Feature flags */
#cmakedefine01 KEEL_USE_IOURING
#cmakedefine01 KEEL_USE_LIBUV

/* Compression */
#cmakedefine01 KEEL_HAS_ZSTD

/* Stats / Instrumentation flags */
#cmakedefine01 KEEL_ENABLE_SYSTEM_STATS
#cmakedefine01 KEEL_ENABLE_TRACE
#cmakedefine01 KEEL_ENABLE_FULL_STATS

/* Build configuration */
#define KEEL_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

/* Compiler information */
#define KEEL_COMPILER_ID "@CMAKE_C_COMPILER_ID@"
#define KEEL_COMPILER_VERSION "@CMAKE_C_COMPILER_VERSION@"

#endif /* KEEL_CONFIG_H */
